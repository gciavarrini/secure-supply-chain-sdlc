# Secrets for the secure-supply-chain-sdlc pattern.
#
# The installer reads this file when loading secrets (make install); the preferred
# location for the REAL values is outside the repo, at:
#   ~/.config/validated-patterns/values-secret-secure-supply-chain-sdlc.yaml
# which takes precedence over this template. NEVER commit filled-in values.
#
# `make operator-deploy` installs the pattern without loading secrets at all.
#
# Format reference:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils

version: "2.0"

secrets:
  # Bot account the ChatOps listener and Tekton pipelines use to talk to the Git
  # provider (Gitea by default). The token is created in the Gitea UI and pasted
  # in when prompted — it cannot be auto-generated.
  - name: ssf-gitea
    fields:
      - name: token
        value: null
        onMissingValue: prompt
        prompt: "Gitea personal access token for the bot user"

  # Cosign key pair used to sign builds (wired in E3.5). Generate once locally:
  #   cosign generate-key-pair    # writes cosign.key / cosign.pub
  # then answer the prompts with the paths.
  - name: ssf-cosign
    fields:
      - name: privatekey
        path: ~/cosign.key
        base64: true
        onMissingValue: prompt
        prompt: "Path to the cosign private key (cosign.key)"
      - name: publickey
        path: ~/cosign.pub
        base64: true
        onMissingValue: prompt
        prompt: "Path to the cosign public key (cosign.pub)"

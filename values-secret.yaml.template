# Secrets for the secure-supply-chain-sdlc pattern.
#
# Copy this file to values-secret.yaml, fill in the values, and NEVER commit the
# real file (values-secret* is already in .gitignore).
#
# Format reference:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils#values-secret-file-format

version: "2.0"

secrets:
  # Bot account the ChatOps listener and Tekton pipelines use to talk to the Git
  # provider (Gitea by default; the token is whatever the provider adapter needs).
  - name: ssf-gitea
    fields:
      - name: token
        # Fill in: Gitea personal access token for the bot user.
        onMissingValue: generate

  # Cosign key pair used to sign builds (wired in E3.5, build & sign tasks).
  # Generate locally with: cosign generate-key-pair
  - name: ssf-cosign
    fields:
      - name: privatekey
        onMissingValue: generate
      - name: publickey
        onMissingValue: generate
